port=3000

# MongoDB and JWT
mango_url=mongodb://127.0.0.1:27017/ecommerce
acess_token=replace-with-a-long-random-secret
refresh_token=replace-with-a-different-long-random-secret

# Frontend and email
FRONTEND_URL=http://localhost:3000
RESET_PASSWORD_FRONTEND_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
EMAIL=your-email@example.com
EMAIL_PASSWORD=your-email-app-password

# Optional Supabase integration
supabaseurl=https://your-project.supabase.co
project_url=https://your-project.supabase.co
SECRET_KEY=your-supabase-key
DATABASE_URL=postgresql://user:password@host:6543/database
DIRECT_URL=postgresql://user:password@host:5432/database

# Image storage: local, cloudinary, or s3
IMAGE_STORAGE_PROVIDER=local

# Cloudinary (required when IMAGE_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (required when IMAGE_STORAGE_PROVIDER=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_BUCKET_NAME=your-bucket-name
# Optional, recommended for private S3 buckets
AWS_CLOUDFRONT_URL=https://cdn.example.com

# Razorpay
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
